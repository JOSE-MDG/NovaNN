# clangd configuration — NovaNN
#
# Structure:
#   1. Global compile flags and diagnostics (applies to all files)
#   2. C-file diagnostics and naming (all *.c)
#   3. C++-file diagnostics and naming (all *.cpp, *.hpp, etc.)
#   4. ncore/ C23 compilation (gcc -std=c23)

CompileFlags:
  CompilationDatabase: build
  Remove:
    - -forward-unknown-to-host-compiler
  Add:
    - -O3
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wshadow
    - -Wcast-align
    - -Wconversion
    - -Wformat=2
    - -Wimplicit-fallthrough
    - -Wnull-dereference
    - -Wpointer-arith
    - -Wundef
    - -Wuninitialized
    - -Wunused
    - -Wno-unused-parameter
    - -g
    - -fno-omit-frame-pointer
    - -mtune=generic
    - -march=x86-64-v2

Diagnostics:
  ClangTidy:
    Add:
      - clang-diagnostic-*
      - clang-analyzer-*
      - bugprone-*
      - misc-*
      - modernize-*
      - performance-*
      - portability-*
      - readability-*
    Remove:
      - bugprone-easily-swappable-parameters
      - bugprone-reserved-identifier
      - bugprone-narrowing-conversions
      - bugprone-implicit-widening-of-multiplication-result
      - bugprone-casting-through-void
      - modernize-use-trailing-return-type
      - modernize-use-auto
      - modernize-macro-to-enum
      - readability-magic-numbers
      - readability-function-cognitive-complexity
      - readability-identifier-length
      - readability-named-parameter
      - readability-function-size
      - readability-else-after-return
      - readability-redundant-preprocessor
      - readability-isolate-declaration
      - readability-uppercase-literal-suffix

Index:
  Background: Build

Completion:
  AllScopes: true
  HeaderInsertion: IWYU

Hover:
  ShowAKA: true

InlayHints:
  Enabled: true

---
If:
  PathMatch: .*\.c$

Diagnostics:
  ClangTidy:
    Remove:
      - modernize-use-trailing-return-type
      - modernize-use-auto
      - modernize-macro-to-enum
      - performance-*
    Add:
      - modernize-use-nullptr
      - modernize-use-bool-literals
      - modernize-use-default-member-init
      - misc-const-correctness
      - misc-definitions-in-headers
      - misc-header-include-cycle
      - misc-misplaced-const
      - misc-no-recursion
      - misc-redundant-expression
      - misc-static-assert
    CheckOptions:
      readability-identifier-naming.FunctionCase: "lower_case"
      readability-identifier-naming.VariableCase: "lower_case"
      readability-identifier-naming.GlobalVariableCase: "lower_case"
      readability-identifier-naming.GlobalConstantCase: "lower_case"
      readability-identifier-naming.EnumCase: "CamelCase"
      readability-identifier-naming.EnumConstantCase: "CamelCase"
      readability-identifier-naming.TypedefCase: "CamelCase"
      readability-identifier-naming.MacroDefinitionCase: "UPPER_CASE"
      readability-identifier-naming.MemberCase: "lower_case"
      readability-identifier-naming.ConstVariableCase: "lower_case"
      readability-braces-around-statements.ShortStatementLines: 1
      bugprone-assert-side-effect.AssertMacros: "NOVA_INTERNAL_ASSERT"
---
If:
  PathMatch: .*\.(cpp|hpp|cc|cxx|cu|cuh)$

Diagnostics:
  ClangTidy:
    Remove:
      - modernize-use-nullptr
      - modernize-use-bool-literals
      - misc-no-recursion
    Add:
      - misc-const-correctness
      - misc-definitions-in-headers
      - misc-header-include-cycle
      - misc-misplaced-const
      - misc-redundant-expression
      - misc-static-assert
      - performance-*
    CheckOptions:
      readability-identifier-naming.FunctionCase: "camelBack"
      readability-identifier-naming.ClassCase: "CamelCase"
      readability-identifier-naming.StructCase: "CamelCase"
      readability-identifier-naming.EnumCase: "CamelCase"
      readability-identifier-naming.EnumConstantCase: "CamelCase"
      readability-identifier-naming.TypedefCase: "CamelCase"
      readability-identifier-naming.VariableCase: "camelBack"
      readability-identifier-naming.LocalVariableCase: "camelBack"
      readability-identifier-naming.GlobalVariableCase: "camelBack"
      readability-identifier-naming.MemberCase: "camelBack"
      readability-identifier-naming.PrivateMemberPrefix: "m_"
      readability-identifier-naming.GlobalConstantCase: "UPPER_CASE"
      readability-identifier-naming.MacroDefinitionCase: "UPPER_CASE"
      readability-braces-around-statements.ShortStatementLines: 1
      bugprone-assert-side-effect.AssertMacros: "NOVA_INTERNAL_ASSERT"
---
If:
  PathMatch: ncore/.*\.c$
CompileFlags:
  Compiler: gcc
  Add: [-std=c23]
---
If:
  PathMatch: .*\.(cpp|hpp|cc|cxx)$
CompileFlags:
  Compiler: g++
  Add: [-std=c++23]
