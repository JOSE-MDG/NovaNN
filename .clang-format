---
# NovaNN native-core style — derived from ncore/ code conventions.
# Based on the official LLVM style; only the deviations below are explicit.
BasedOnStyle: LLVM
Language: Cpp
ReflowComments: Never
AttributeMacros:
  - __capability
  - ALIGN
  - ATTR
  - __attribute__
StatementAttributeLikeMacros:
  - Q_EMIT
  - ATTR
