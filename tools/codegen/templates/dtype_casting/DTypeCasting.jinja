{%- from "utils/DTypes.jinja" import c_type, ptr_member %}

{#-
  Returns a C-style cast prefix for a given dtype abbreviation, e.g.
  "(int8)" for "s8", meant to be prepended directly to an expression in
  generated code (e.g. `d[i] = {{ cast_expr(dst_abbr) }}s[i];` produces
  `d[i] = (int8)s[i];`).

  Only f32/f64 and the integer dtypes have an entry, since those are the
  only types with a real, directly-usable C type name to cast to.
  Reduced-precision float dtypes (fp16, bf16, fp8e4m3, fp8e5m2, fp4e2m1)
  fall through to the `else` branch and return an empty string, since
  those types are never produced via a plain C cast -- only via their
  dedicated to_float/from_float conversion functions (see
  sig.to_float_signature / sig.from_float_signature).

  @param abbr  Destination dtype abbreviation (e.g. "s8", "f32", "fp16").
  @return      A parenthesized C cast (e.g. "(int8)"), or "" if `abbr`
               has no entry in this macro.
-#}
{%- macro cast_expr(abbr) -%}
  {%- if abbr == "f32" %}(float)
    {%- elif abbr == "f64" %}(double)
    {%- elif abbr == "s8" %}(int8)
    {%- elif abbr == "s16" %}(int16)
    {%- elif abbr == "s32" %}(int32)
    {%- elif abbr == "s64" %}(int64)
    {%- elif abbr == "u8" %}(uint8)
    {%- elif abbr == "u16" %}(uint16)
    {%- elif abbr == "u32" %}(uint32)
    {%- elif abbr == "u64" %}(uint64)
  {%- else %}
  {%- endif -%}
{%- endmacro -%}

{#- Predicate macros used to branch the scalar saturation/conversion
    code generated below. Each returns the string "true" or "false"
    (compared with `== "true"`, since Jinja renders macro output as text). -#}

{#-
  @param abbr  Dtype abbreviation.
  @return      "true" if `abbr` is any integer dtype (signed or
               unsigned), "false" otherwise.
-#}
{%- macro is_integer_dst(abbr) -%}
  {%- if abbr in ("s8", "s16", "s32", "s64", "u8", "u16", "u32", "u64") %}true{%- else %}false{%- endif -%}
{%- endmacro -%}

{#-
  @param abbr  Dtype abbreviation.
  @return      "true" if `abbr` is a signed integer dtype (s8/s16/s32/s64),
               "false" otherwise. Used to pick between gen_clamp_signed()
               and gen_clamp_unsigned() in gen_clamp().
-#}
{%- macro is_signed_dst(abbr) -%}
  {%- if abbr in ("s8", "s16", "s32", "s64") %}true{%- else %}false{%- endif -%}
{%- endmacro -%}

{#-
  @param abbr  Dtype abbreviation.
  @return      "true" if `abbr` is an unsigned integer dtype
               (u8/u16/u32/u64), "false" otherwise.
-#}
{%- macro is_unsigned_dst(abbr) -%}
  {%- if abbr in ("u8", "u16", "u32", "u64") %}true{%- else %}false{%- endif -%}
{%- endmacro -%}

{#-
  @param abbr  Dtype abbreviation.
  @return      "true" if `abbr` is one of the float source dtypes that
               get converted through an intermediate `float` (all reduced-
               precision floats plus f32 itself), "false" otherwise. f64
               is deliberately excluded, since f64 sources are used
               directly as `double` in emit_kernel_body() rather than
               being routed through a `float` intermediate.
-#}
{%- macro is_float_src(abbr) -%}
  {%- if abbr in ("f32", "fp16", "bf16", "fp8e4m3", "fp8e5m2", "fp4e2m1") %}true{%- else %}false{%- endif -%}
{%- endmacro -%}

{#-
  @param abbr  Dtype abbreviation.
  @return      "true" if `abbr` is "f64", "false" otherwise.

  Used by bounds_var() to pick the f32 vs f64 sub-table of
  rules.funcs.integers_bound (see bounds_var() docstring). Also the
  counterpart to is_float_src() for dst/src classification.
-#}
{%- macro is_double_src(abbr) -%}
  {%- if abbr == "f64" %}true{%- else %}false{%- endif -%}
{%- endmacro -%}

{#-
  Looks up the literal min/max bound for a destination integer dtype from
  the rules file, to use as a clamp bound in generated saturation code
  (e.g. bounds_var("s8", "min", "fp16") might yield "-32768.0").

  The bound is precision-specific: rules.funcs.integers_bound has separate
  "f32" and "f64" sub-tables, because INT32_MAX/UINT32_MAX/INT64_MAX/
  UINT64_MAX are not exactly representable in either float or double, and
  the largest exactly-representable value <= the true type max differs
  between the two precisions (e.g. s64 max is 9223371487098961920.0 in
  float32 but 9223372036854774784.0 in double). Reusing one literal for
  both precisions would let the clamp's upper bound round past the
  destination type's actual max, producing an out-of-range value that
  overflows on the subsequent (dsttype) cast. src_abbr selects which
  sub-table to read via is_double_src(): "f64" for an f64 source, "f32"
  for every other (reduced-precision or f32) source, since all of those
  are routed through a `float` intermediate in emit_kernel_body().

  @param dst_abbr  Destination integer dtype abbreviation (e.g. "s8").
  @param bound     Which bound to fetch: "min" or "max".
  @param src_abbr  Source dtype abbreviation, selects the f32/f64 sub-table.
  @return          The bound literal as defined in
                    rules.funcs.integers_bound[precision][dst_abbr][bound].
-#}
{%- macro bounds_var(dst_abbr, bound, src_abbr) -%}
  {%- if is_double_src(src_abbr) == "true" -%}
    {{ rules.funcs.integers_bound.f64[dst_abbr][bound] }}
  {%- else -%}
    {{ rules.funcs.integers_bound.f32[dst_abbr][bound] }}
  {%- endif -%}
{%- endmacro -%}

{#-
  Returns the "f" suffix to append to a clamp bound literal so its type
  matches the value being compared against it in generated C code. When
  the source is a float-typed intermediate (is_float_src), the bound
  needs an explicit "f" suffix so the comparison is float-vs-float
  (e.g. `v < -128.0f`) rather than float-vs-double, which would otherwise
  silently promote the comparison. No suffix is added for f64 sources
  (compared as `double`, which is the default literal type) or integer
  sources.

  @param src_abbr  Source dtype abbreviation (e.g. "fp16", "f64").
  @return          "f" if the source converts through `float`, "" otherwise.
-#}
{%- macro sat_suffix(src_abbr) -%}
  {%- if is_float_src(src_abbr) == "true" %}f{%- else %}{%- endif -%}
{%- endmacro -%}

{#-
  Generates the ternary clamp expression for casting `val` into a signed
  integer destination: maps NaN to `nan_r`, then clamps `val` into
  [dst_min, dst_max] before the caller casts the result to dsttype.

  @param val       Expression to clamp (e.g. "v", "lo", "hi").
  @param dst_abbr  Signed integer destination dtype abbreviation (e.g. "s8").
  @param src_abbr  Source dtype abbreviation, used only to pick the bound
                    literal's suffix via sat_suffix().
  @param nan_r     Replacement value emitted when `val` is NaN.
  @return          A C ternary expression, e.g.:
                    `isnan(v) ? 0 : (v < -128.0f ? -128.0f : (v > 127.0f ? 127.0f : v))`
-#}
{%- macro gen_clamp_signed(val, dst_abbr, src_abbr, nan_r) -%}
  isnan({{ val }}) ? {{ nan_r }} : ({{ val }} < {{ bounds_var(dst_abbr, "min", src_abbr) }}{{ sat_suffix(src_abbr) }} ? {{ bounds_var(dst_abbr, "min", src_abbr) }}{{ sat_suffix(src_abbr) }} : ({{ val }} > {{ bounds_var(dst_abbr, "max", src_abbr) }}{{ sat_suffix(src_abbr) }} ? {{ bounds_var(dst_abbr, "max", src_abbr) }}{{ sat_suffix(src_abbr) }} : {{ val }}))
{%- endmacro -%}

{#-
  Generates the ternary clamp expression for casting `val` into an
  unsigned integer destination. Unlike gen_clamp_signed(), the lower
  bound is a hardcoded `0` rather than a looked-up minimum: any value
  <= 0 saturates to 0 regardless of destination width, since unsigned
  dtypes have no representable negative range and casting a negative
  float to unsigned is UB in C.

  @param val       Expression to clamp (e.g. "v", "lo", "hi").
  @param dst_abbr  Unsigned integer destination dtype abbreviation (e.g. "u8").
  @param src_abbr  Source dtype abbreviation, used only to pick the bound
                    literal's suffix via sat_suffix().
  @param nan_r     Replacement value emitted when `val` is NaN.
  @return          A C ternary expression, e.g.:
                    `isnan(v) ? 0 : (v <= 0 ? 0 : (v > 255.0f ? 255.0f : v))`
-#}
{%- macro gen_clamp_unsigned(val, dst_abbr, src_abbr, nan_r) -%}
  {%- if src_abbr == 'fp4e2m1' %}
  {{ val }} <= 0 ? 0 : ({{ val }} > {{ bounds_var(dst_abbr, "max", src_abbr) }}{{ sat_suffix(src_abbr) }} ? {{ bounds_var(dst_abbr, "max", src_abbr) }}{{ sat_suffix(src_abbr) }} : {{ val }})
  {%- else %}
  isnan({{ val }}) ? {{ nan_r }} : ({{ val }} <= 0 ? 0 : ({{ val }} > {{ bounds_var(dst_abbr, "max", src_abbr) }}{{ sat_suffix(src_abbr) }} ? {{ bounds_var(dst_abbr, "max", src_abbr) }}{{ sat_suffix(src_abbr) }} : {{ val }}))
  {%- endif %}
{%- endmacro -%}

{#-
  Dispatches to gen_clamp_signed() or gen_clamp_unsigned() depending on
  whether the destination dtype is signed or unsigned. This is the entry
  point used by emit_kernel_body() wherever a saturating float->integer
  clamp needs to be generated.

  @param val       Expression to clamp (e.g. "v", "lo", "hi").
  @param dst_abbr  Integer destination dtype abbreviation.
  @param src_abbr  Source dtype abbreviation, forwarded to sat_suffix().
  @param nan_r     Replacement value emitted when `val` is NaN.
  @return          A C ternary clamp expression, from gen_clamp_signed()
                    or gen_clamp_unsigned() depending on dst_abbr's signedness.
-#}
{%- macro gen_clamp(val, dst_abbr, src_abbr, nan_r) -%}
  {%- if is_signed_dst(dst_abbr) == "true" %}{{ gen_clamp_signed(val, dst_abbr, src_abbr, nan_r) }}
  {%- else %}{{ gen_clamp_unsigned(val, dst_abbr, src_abbr, nan_r) }}
  {%- endif -%}
{%- endmacro -%}

{#-
  Generates the ternary clamp expression for casting an integer `val` into
  a s8 or u8 destination. Unlike gen_clamp_signed/gen_clamp_unsigned, the
  bounds are hardcoded integer literals (no .0 suffix) and no isnan() check
  is emitted, since integer sources have no NaN encodings.

  Only intended for use with su8_downcast_clamp entries (dest s8 or u8).

  @param val       Expression to clamp (e.g. "s[i]").
  @param dst_abbr  Destination dtype abbreviation (must be "s8" or "u8").
  @param src_abbr  Source dtype abbreviation, used to determine signedness.
  @return          A C ternary clamp expression without isnan(), e.g.:
                    `(v < -128 ? -128 : (v > 127 ? 127 : v))`
-#}
{%- macro gen_integer_clamp(val, dst_abbr, src_abbr) -%}
  {%- if is_signed_dst(dst_abbr) == "true" -%}
    {%- if is_signed_dst(src_abbr) == "true" -%}
  ({{ val }} < -128 ? -128 : ({{ val }} > 127 ? 127 : {{ val }}))
    {%- else -%}
  ({{ val }} > 127 ? 127 : {{ val }})
    {%- endif -%}
  {%- else -%}
    {%- if is_signed_dst(src_abbr) == "true" -%}
  ({{ val }} <= 0 ? 0 : ({{ val }} > 255 ? 255 : {{ val }}))
    {%- else -%}
  ({{ val }} > 255 ? 255 : {{ val }})
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{#-
  Emits the full body of one t<src>_to_<dst>_scalar() kernel: pointer
  unwrapping + saturating/non-saturating conversion loop.

  Shared by both the _GNUC_CLANG_ branch and its portable #else fallback
  in the loop below -- the two branches only differ in which macro they
  use to resolve src/dst pointer C types (compiler_c_type vs c_type),
  never in the loop logic itself. Keeping a single definition means the
  saturation/packed/float branching below is written and maintained
  exactly once instead of twice.

  @param type_of     Macro used to resolve src/dst pointer C types
                      (compiler_c_type for the _GNUC_CLANG_ branch,
                      c_type for the portable fallback).
  @param from_float_source Whether the source dtype already is a float dtype
  @param sig          Current signature dict from rules.funcs.types[*].signatures.
  @param src_abbr     Source dtype abbreviation (e.g. "fp16").
  @param dst_abbr     Destination dtype abbreviation (e.g. "s8").
  @param src_ptr      Source Tensor.data union member name.
  @param dst_ptr      Destination Tensor.data union member name.
  @param from_float   Whether sig defines from_float_signature.
  @param to_float     Whether sig defines to_float_signature.
  @param special_case Whether sig defines special_case.
  @param is_packed    Whether this is a packed (fp4e2m1) conversion.

  Jinja macros do not inherit the caller's loop-local variables, so every
  value the body needs must be threaded through explicitly rather than
  read off the enclosing {% for %} scope.
-#}
{%- macro emit_kernel_body(type_of, from_float_source, sig, src_abbr, dst_abbr, src_ptr, dst_ptr, from_float, to_float, special_case, is_packed) %}
  const {{ type_of(src_abbr) }} *s = src->data.{{ src_ptr }};
  {{ type_of(dst_abbr) }} *d = dst->data.{{ dst_ptr }};
{%- set do_saturate = sig.saturate | default(false) and is_integer_dst(dst_abbr) %}
{%- set nan_check_only = sig.nan_check_only | default(false) %}
{%- set nan_r = 0 %}
{%- set do_su8_clamp = sig.su8_downcast_clamp | default(false) %}
{%- if do_saturate or nan_check_only%}
  {#- Saturating floating -> integer #}
{%- if is_packed %}
  for (size_t i = 0; i < src->size; ++i) {
    float lo, hi;
    {{ sig.to_float_signature }}(s[i], &lo, &hi);
    lo = {{ gen_clamp('lo', dst_abbr, src_abbr, nan_r) }};
    hi = {{ gen_clamp('hi', dst_abbr, src_abbr, nan_r) }};
    d[(i * 2)] = {{ cast_expr(dst_abbr) }}lo;
    d[(i * 2) + 1] = {{ cast_expr(dst_abbr) }}hi;
  }
{%- elif to_float %}
  for (size_t i = 0; i < src->size; ++i) {
    float v = {{ sig.to_float_signature }}(s[i]);
    v = {{ gen_clamp('v', dst_abbr, src_abbr, nan_r) }};
    d[i] = {{ cast_expr(dst_abbr) }}v;
  }
{%- else %}
  {#- f32/f64 direct to integer #}
  for (size_t i = 0; i < src->size; ++i) {
    {{ 'float' if is_float_src(src_abbr) == "true" else 'double' }} v = s[i];
    v = {{ gen_clamp('v', dst_abbr, src_abbr, nan_r) }};
    d[i] = {{ cast_expr(dst_abbr) }}v;
  }
{%- endif %}
{%- else %}
  {#- Original code without saturation #}
{%- if is_packed %}
  for (size_t i = 0; i < src->size; ++i) {
    float lo, hi;
    {{ sig.to_float_signature }}(s[i], &lo, &hi);
{%- if special_case %}
    d[i] = {{ sig.from_float_signature }}((float)s[(2 * i)], (float)s[(2 * i) + 1]);
{%- elif from_float %}
    d[(i * 2)] = {{ sig.from_float_signature }}(lo);
    d[(i * 2) + 1] = {{ sig.from_float_signature }}(hi);
{%- else %}
{%- if cast_expr(dst_abbr) != '(float)' %}
    d[(i * 2)] = {{ cast_expr(dst_abbr) }}lo;
    d[(i * 2) + 1] = {{ cast_expr(dst_abbr) }}hi;
{%- else %}
    d[(i * 2)] = lo;
    d[(i * 2) + 1] = hi;
{%- endif %}
{%- endif %}
  }
{%- elif from_float and to_float %}
{%- if special_case %}
  for (size_t i = 0; i < dst->size; ++i) {
    d[i] = {{ sig.from_float_signature }}({{ sig.to_float_signature }}(s[(2 * i)]), {{ sig.to_float_signature }}(s[(2 * i) + 1]));
  }
{%- else %}
  for (size_t i = 0; i < src->size; ++i) {
    d[i] = {{ sig.from_float_signature }}({{ sig.to_float_signature }}(s[i]));
  }
{%- endif %}
{%- elif to_float %}
  for (size_t i = 0; i < src->size; ++i) {
{%- if cast_expr(dst_abbr) != '(float)' %}
    d[i] = {{ cast_expr(dst_abbr) }}{{ sig.to_float_signature }}(s[i]);
{%- else %}
    d[i] = {{ sig.to_float_signature }}(s[i]);
{%- endif %}
  }
{%- elif from_float %}
{%- if special_case %}
  for (size_t i = 0; i < dst->size; ++i) {
    {%- if from_float_source %}
    d[i] = {{ sig.from_float_signature }}(s[(2 * i)], s[(2 * i) + 1]);
    {%- else %}
    d[i] = {{ sig.from_float_signature }}((float)s[(2 * i)], (float)s[(2 * i) + 1]);
    {%- endif %}
  }
{%- else %}
  for (size_t i = 0; i < src->size; ++i) {
    {%- if from_float_source %}
    d[i] = {{ sig.from_float_signature }}(s[i]);
    {%- else %}
    d[i] = {{ sig.from_float_signature }}((float)s[i]);
    {%- endif %}
  }
{%- endif %}
{%- else %}
  {%- if do_su8_clamp %}
    {#- su8 downcast: integer clamp instead of wrap #}
  for (size_t i = 0; i < src->size; ++i) {
    {{ c_type(src_abbr) }} val = s[i];
    d[i] = {{ cast_expr(dst_abbr) }}{{ gen_integer_clamp('val', dst_abbr, src_abbr) }};
  }
  {%- else %}
  for (size_t i = 0; i < src->size; ++i) {
    d[i] = {{ cast_expr(dst_abbr) }}s[i];
  }
  {%- endif %}
{%- endif %}
{%- endif %}
{%- endmacro %}

{%- for category in rules.funcs.types.values() %}
{%- for sig in category.signatures %}
{%- set name = sig.name %}
{%- set parts = name[1:] | replace("_scalar", "") | split("_to_") %}
{%- set src_abbr = parts[0] %}
{%- set dst_abbr = parts[1] %}
{%- set src_c = c_type(src_abbr) %}
{%- set dst_c = c_type(dst_abbr) %}
{%- set src_ptr = ptr_member(src_abbr) %}
{%- set dst_ptr = ptr_member(dst_abbr) %}
{%- set from_float = sig.from_float_signature is defined %}
{%- set to_float = sig.to_float_signature is defined %}
{%- set is_float_source = sig.from_float_source is defined %}
{%- set special_case = sig.special_case is defined%}
{%- set is_packed = sig.is_packed | default(false) %}

/**
 * @brief Convert every element from {{ src_c }} to {{ dst_c }}
 *
 * @param[in]  src  Source tensor with element type {{ src_c }}.
 * @param[out] dst  Destination tensor with element type {{ dst_c }}.
 */
{{ rules.funcs.return }} {{ name }}({{ rules.funcs.arguments }}) {
{{- emit_kernel_body(c_type, is_float_source, sig, src_abbr, dst_abbr, src_ptr, dst_ptr, from_float, to_float, special_case, is_packed) }}
}
{%- endfor %}
{%- endfor %}

/* =========================================================================
 * SIMD kernels
 * ========================================================================= */

#ifdef _GNUC_CLANG_

/**
 * @brief Cast every element from float16 to float using AVX-512.
 *
 * Requires: AVX512F
 *
 * @param[in]  src  Source tensor with element type float16.
 * @param[out] dst  Destination tensor with element type float.
 */
[[gnu::target("avx512f")]] void tfp16_to_f32_avx512(const Tensor *restrict src,
                                                    Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_F32_WITH_AVX512F;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float16 *s = src->data.half;
  float *d = dst->data.f32;
  for (; i < n; i += step) {
    __m256i v_src = _mm256_loadu_si256((const __m256i_u *)&s[i]);
    __m512 v_dst = _mm512_cvtph_ps(v_src);
    _mm512_storeu_ps(&d[i], v_dst);
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, float)
  }
}

/**
 * @brief Cast every element from float16 to float using AVX/AVX2.
 *
 * Requires: AVX/AVX2, F16C
 *
 * @param[in]  src  Source tensor with element type float16.
 * @param[out] dst  Destination tensor with element type float.
 */
[[gnu::target("avx,avx2,f16c")]] void
tfp16_to_f32_avx_avx2_fp16c(const Tensor *restrict src, Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_F32_WITH_AVX_AVX2;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float16 *s = src->data.half;
  float *d = dst->data.f32;
  for (; i < n; i += step) {
    __m128i v_src = _mm_loadu_si128((const __m128i_u *)&s[i]);
    __m256 v_dst = _mm256_cvtph_ps(v_src);
    _mm256_storeu_ps(&d[i], v_dst);
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, float)
  }
}

/**
 * @brief Cast every element from float16 to double using AVX-512.
 *
 * Requires: AVX512F, AVX512FP16
 *
 * @param[in]  src  Source tensor with element type float16.
 * @param[out] dst  Destination tensor with element type double.
 */
[[gnu::target("avx512f,avx512fp16")]] void
tfp16_to_f64_avx512(const Tensor *restrict src, Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_F64_WITH_AVX512F;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float16 *s = src->data.half;
  double *d = dst->data.f64;
  for (; i < n; i += step) {
    __m128h v_src = (__m128h)_mm_loadu_si128((const __m128i_u *)&s[i]);
    __m512d v_dst = _mm512_cvtph_pd(v_src);
    _mm512_storeu_pd(&d[i], v_dst);
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, double)
  }
}

/**
 * @brief Cast every element from float16 to double using AVX/AVX2.
 *
 * Requires: F16C
 *
 * @param[in]  src  Source tensor with element type float16.
 * @param[out] dst  Destination tensor with element type double.
 */
[[gnu::target("f16c")]] void
tfp16_to_f64_avx_avx2_fp16c(const Tensor *restrict src, Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_F64_WITH_AVX_AVX2;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float16 *s = src->data.half;
  double *d = dst->data.f64;
  for (; i < n; i += step) {
    __m128i v = _mm_loadl_epi64((const __m128i_u *)&s[i]);
    __m128 f32 = _mm_cvtph_ps(v);
    __m256d r = _mm256_cvtps_pd(f32);
    _mm256_storeu_pd(&d[i], r);
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, double)
  }
}

/**
 * @brief Cast every element from float16 to bfloat16 using AVX-512.
 *
 * Requires: AVX512F, AVX512BF16
 *
 * @param[in]  src  Source tensor with element type float16.
 * @param[out] dst  Destination tensor with element type bfloat16.
 */
[[gnu::target("avx512f,avx512bf16")]] void
tfp16_to_bf16_avx512bf16(const Tensor *restrict src, Tensor *restrict dst) {
  const size_t step = 16;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float16 *s = src->data.half;
  bfloat16 *d = dst->data.bf16;
  for (; i < n; i += step) {
    __m256i v_src = _mm256_loadu_si256((const __m256i_u *)&s[i]);
    __m512 v_inter = _mm512_cvtph_ps(v_src);
    __m256bh v_dst = _mm512_cvtneps_pbh(v_inter);
    memcpy(&d[i], &v_dst, sizeof(v_dst));
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, bfloat16)
  }
}

/**
 * @brief Cast every element from float to float16 using AVX-512.
 *
 * Requires: AVX512F, AVX512FP16
 *
 * @param[in]  src  Source tensor with element type float.
 * @param[out] dst  Destination tensor with element type float16.
 */
[[gnu::target("avx512f,avx512fp16")]] void
tf32_to_fp16_avx512fp16(const Tensor *restrict src, Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_FP16_WITH_AVX512F;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float *s = src->data.f32;
  float16 *d = dst->data.half;
  for (; i < n; i += step) {
    __m512 v0 = _mm512_loadu_ps(&s[i]);
    __m512 v1 = _mm512_loadu_ps(&s[i + 16]);
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wsign-conversion"
    __m256i r0 =
        _mm512_cvtps_ph(v0, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
    __m256i r1 =
        _mm512_cvtps_ph(v1, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
#pragma GCC diagnostic pop
    _mm256_storeu_si256((__m256i_u *)&d[i], r0);
    _mm256_storeu_si256((__m256i_u *)&d[i + 16], r1);
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, float16)
  }
}

/**
 * @brief Cast every element from float to float16 using AVX/AVX2.
 *
 * Requires: F16C
 *
 * @param[in]  src  Source tensor with element type float.
 * @param[out] dst  Destination tensor with element type float16.
 */
[[gnu::target("f16c")]] void
tf32_to_fp16_avx_avx2_f16c(const Tensor *restrict src, Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_FP16_WITH_AVX_AVX2;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float *s = src->data.f32;
  float16 *d = dst->data.half;
  for (; i < n; i += step) {
    __m256 v0 = _mm256_loadu_ps(&s[i]);
    __m256 v1 = _mm256_loadu_ps(&s[i + 8]);
    __m128i r0 =
        _mm256_cvtps_ph(v0, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
    __m128i r1 =
        _mm256_cvtps_ph(v1, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
    _mm_storeu_si128((__m128i_u *)&d[i], r0);
    _mm_storeu_si128((__m128i_u *)&d[i + 8], r1);
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, float16)
  }
}

/**
 * @brief Cast every element from float to double using AVX-512.
 *
 * Requires: AVX512F
 *
 * @param[in]  src  Source tensor with element type float.
 * @param[out] dst  Destination tensor with element type double.
 */
[[gnu::target("avx512f")]] void tf32_to_f64_avx512(const Tensor *restrict src,
                                                   Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_F64_WITH_AVX512F;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float *s = src->data.f32;
  double *d = dst->data.f64;
  for (; i < n; i += step) {
    __m256 v = _mm256_loadu_ps(&s[i]);
    __m512d r = _mm512_cvtps_pd(v);
    _mm512_storeu_pd(&d[i], r);
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, double)
  }
}
/**
 * @brief Cast every element from float to double using AVX/AVX2.
 *
 * Requires: AVX/AVX2
 *
 * @param[in]  src  Source tensor with element type float.
 * @param[out] dst  Destination tensor with element type double.
 */
[[gnu::target("avx,avx2")]] void
tf32_to_f64_avx_avx2(const Tensor *restrict src, Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_F64_WITH_AVX_AVX2;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float *s = src->data.f32;
  double *d = dst->data.f64;
  for (; i < n; i += step) {
    __m128 v = _mm_loadu_ps(&s[i]);
    __m256d r = _mm256_cvtps_pd(v);
    _mm256_storeu_pd(&d[i], r);
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, double)
  }
}
/**
 * @brief Cast every element from float to double using SSE4.2.
 *
 * Requires: SSE4.2
 *
 * @param[in]  src  Source tensor with element type float.
 * @param[out] dst  Destination tensor with element type double.
 */
[[gnu::target("sse4.2")]] void tf32_to_f64_sse4_2(const Tensor *restrict src,
                                                  Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_F32_WITH_SSE;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float *s = src->data.f32;
  double *d = dst->data.f64;
  for (; i < n; i += step) {
    __m128 v = _mm_loadu_ps(&s[i]);
    _mm_storeu_pd(&d[i], _mm_cvtps_pd(v));
    _mm_storeu_pd(&d[i + 2], _mm_cvtps_pd(_mm_movehl_ps(v, v)));
  }
  if (rem > 0) {
    REMAINING(i, size, d, s, double)
  }
}

/**
 * @brief Cast every element from float to bfloat16 using AVX-512.
 *
 * Requires: AVX512F, AVX512BF16, AVX512BW, AVX512VL
 *
 * @param[in]  src  Source tensor with element type float.
 * @param[out] dst  Destination tensor with element type bfloat16.
 */
[[gnu::target("avx512f,avx512bf16,avx512bw,avx512vl")]] void
tf32_to_bf16_avx512bf16(const Tensor *restrict src, Tensor *restrict dst) {
  const size_t step = NOVA_SIMD_BF16_WITH_AVX512F;
  size_t i = 0;
  size_t rem = src->size % step;
  size_t n = src->size - rem;
  size_t size = src->size;
  const float *s = src->data.f32;
  bfloat16 *d = dst->data.bf16;
  for (; i < n; i += step) {
    __m512 v0 = _mm512_loadu_ps(&s[i]);
    __m512 v1 = _mm512_loadu_ps(&s[i + 16]);
    __m256bh r0 = _mm512_cvtneps_pbh(v0);
