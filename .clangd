CompileFlags:
  Add:
    - -Incore/include
    - -I/opt/cuda/include
    - -I/opt/rocm/include
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wshadow
    - -Wcast-align
    - -Wconversion
    - -Wfloat-equal
    - -Wformat=2
    - -Wimplicit-fallthrough
    - -Wnull-dereference
    - -Wpointer-arith
    - -Wsign-conversion
    - -Wundef
    - -Wuninitialized
    - -Wunused
    - -Wno-missing-field-initializers
    - -Wno-unused-parameter
    - -g
    - -fno-omit-frame-pointer
    - -march=native
---
If:
  PathMatch: ncore/rust/csrc/.*\.(c|cpp)
CompileFlags:
  Compiler: g++
  Add: [-std=c++23]

---
If:
  PathMatch: ncore/src/core/.*\.c
CompileFlags:
  Compiler: gcc
  Add: [-std=c23]

---
If:
  PathMatch: .*\.(cpp|hpp|cc|cxx)
CompileFlags:
  Compiler: g++
  Add: [-std=c++23]

---
Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - readability-*
      - portability-*
      - clang-analyzer-*
    Remove:
      - readability-magic-numbers

Index:
  Background: Build

Completion:
  AllScopes: true
  HeaderInsertion: IWYU

Hover:
  ShowAKA: true

InlayHints:
  Enabled: true
