/**
 * @brief Generate a forward declaration for a single cast function.
 *
 * @details
 * Expands to:
 * @code
 * static inline void t{from}_to_{to}(const Tensor *restrict src,
 *                                     Tensor *restrict dst);
 * @endcode
 *
 * Called via the X-macro families to declare all 210 cast
 * functions before their definitions.
 *
 * @param from  Source dtype short name (e.g., @c fp16, @c s8).
 * @param to    Target dtype short name (e.g., @c f32, @c u64).
 */
#define DECL_CAST(from, to)                                                    \
  static inline void t##from##_to_##to(const Tensor *restrict src,             \
                                       Tensor *restrict dst);

