{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "cpu",
      "hidden": true,
      "inherits": "base",
      "displayName": "CPU backend"
    },
    {
      "name": "cuda",
      "hidden": true,
      "inherits": "base",
      "displayName": "CUDA backend",
      "cacheVariables": {
        "USE_CUDA": "ON"
      }
    },
    {
      "name": "hip",
      "hidden": true,
      "inherits": "base",
      "displayName": "HIP backend",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "USE_HIP": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "USE_LTO": "OFF"
      }
    },
    {
      "name": "asan",
      "hidden": true,
      "inherits": "base",
      "displayName": "AddressSanitizer",
      "cacheVariables": {
        "USE_ASAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "hidden": true,
      "inherits": "base",
      "displayName": "UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "USE_UBSAN": "ON"
      }
    },
    {
      "name": "cpu-release",
      "inherits": "cpu",
      "displayName": "CPU Release",
